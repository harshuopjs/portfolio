# --- Contact form (Gmail SMTP: no extra service needed) ---
# 1. Turn on 2-Step Verification for your Google account.
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character password below (no spaces). Never commit this file.
SMTP_USER=harshblank@gmail.com
SMTP_PASS=
# Where messages are delivered (defaults to SMTP_USER)
CONTACT_TO_EMAIL=harshblank@gmail.com
# Sender of the automatic reply to visitors. Defaults to your Gmail with the display name
# "Harsh Kumar Singh (no-reply)". For a true noreply@ address, add it as a "Send mail as" alias
# in Gmail or use your own domain, then set e.g. AUTOREPLY_FROM="Harsh Kumar Singh <noreply@yourdomain.com>"
# AUTOREPLY_FROM=

# Optional overrides (defaults are Gmail over SSL)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true

# Alternative to SMTP: Resend (https://resend.com). Used only if SMTP_PASS is empty.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=

# Public production URL (enables canonical URL, sitemap, OG URLs)
NEXT_PUBLIC_SITE_URL=

# Optional: raises GitHub API rate limits. Server-side only.
GITHUB_TOKEN=
